{
    "name": "my-blogs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npx tsx scripts/optimize-images.ts && next build && npx tsx scripts/generate-rss.ts && npx pagefind --site out && cp -r out/pagefind public/pagefind",
        "optimize-images": "npx tsx scripts/optimize-images.ts",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
        "new-post": "npx tsx scripts/new-post.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "gray-matter": "^4.0.3",
        "lucide-react": "^0.564.0",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-html": "^16.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "rss": "^1.2.2",
        "tailwind-merge": "^3.5.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/rss": "^0.0.32",
        "@vitejs/plugin-react": "^5.1.4",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "jsdom": "^28.0.0",
        "pagefind": "^1.4.0",
        "prettier": "^3.8.1",
        "sass": "^1.98.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "typescript": "^5",
        "vitest": "^4.0.18"
    }
}
